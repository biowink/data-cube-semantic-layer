CUBEJS_DB_TYPE=athena
# CUBEJS_AWS_KEY / CUBEJS_AWS_SECRET are sourced from AWS Secrets Manager at
# runtime via ./fetch-secrets.sh -> .env.runtime (run it before docker compose up)
CUBEJS_AWS_REGION=eu-west-1
# Restrict information_schema introspection to only the databases our cubes use,
# so schema generation doesn't scan unrelated tables (e.g. snowcat's Iceberg tables)
CUBEJS_DB_SCHEMA=airbyte,core,der,user_metrics
CUBEJS_AWS_S3_OUTPUT_LOCATION=s3://clue-data-dev-cube/
# Optional: pin queries to a specific Athena workgroup
CUBEJS_AWS_ATHENA_WORKGROUP=cubecloud-athena

CUBEJS_API_SECRET=replace-with-a-long-random-secret
CUBEJS_DEV_MODE=true

# Temporary: production-mode test to confirm public:false hides cubes in Metabase
# set CUBEJS_DEV_MODE to false
NODE_ENV=production
CUBEJS_SQL_USER=testuser
CUBEJS_SQL_PASSWORD=<any passwprd>
CUBEJS_PG_SQL_PORT=15432
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory